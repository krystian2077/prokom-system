# =============================================================================
# PRO-KOM Serwis — Zmienne środowiskowe (PRZYKŁAD)
# =============================================================================
# Skopiuj ten plik do .env i uzupełnij wartości:
#   cp .env.example .env
# NIGDY nie commituj pliku .env do repozytorium!
# =============================================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=zmien-na-losowy-klucz-minimum-50-znakow

# Baza danych PostgreSQL (lokalnie)
DB_NAME=prokom_db
DB_USER=postgres
DB_PASSWORD=twoje_haslo_postgres
DB_HOST=localhost
DB_PORT=5432

# W produkcji na Render — zamiast powyższych używa się:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# =============================================================================
# Email — aby wysyłać prawdziwe e-maile (kody weryfikacji, potwierdzenia)
# =============================================================================
# Uzupełnij EMAIL_HOST_USER i EMAIL_HOST_PASSWORD. Bez nich e-maile idą do konsoli.
#
# --- Gmail ---
# 1. Włącz "Hasła aplikacji": Konto Google → Bezpieczeństwo → Weryfikacja 2 kroków → Hasła aplikacji
# 2. Wygeneruj hasło dla "Poczta" / "Inna aplikacja" i wklej poniżej jako EMAIL_HOST_PASSWORD
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=twoj.gmail@gmail.com
# EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
#
# --- Mailtrap (testy, e-maile nie trafiają do skrzynek) ---
# Załóż konto na mailtrap.io, skopiuj dane SMTP z inboxa:
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_HOST_USER=twoj_mailtrap_user
# EMAIL_HOST_PASSWORD=twoj_mailtrap_haslo
#
# --- Inny SMTP (np. hosting, SendGrid, AWS SES) ---
# Ustaw host, port, user, hasło według dokumentacji usługi.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@prokom-serwis.pl

# =============================================================================
# Odpowiedzi klientów e-mailem → wątek w panelu
# =============================================================================
# Samo wysłanie maila z panelu NIE powoduje, że Gmail wywoła backend.
# Żeby odpowiedzi „Odpowiedz” z Gmaila trafiały do systemu, wybierz jedną ścieżkę:
#
# A) Webhook (Mailgun/SendGrid Inbound) — POST na /api/v1/communications/inbound-email/
#    z nagłówkiem X-Inbound-Secret:
# EMAIL_INBOUND_WEBHOOK_SECRET=losowy-długi-sekret
#
# B) Polling IMAP (np. ta sama skrzynka Gmail co wychodzące) — cron co kilka minut:
#    python manage.py poll_inbound_imap
#    Użyj hasła aplikacji (nie zwykłego hasła konta):
# INBOUND_IMAP_HOST=imap.gmail.com
# INBOUND_IMAP_USER=serwisprokomrabka@gmail.com
# INBOUND_IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# INBOUND_IMAP_MAILBOX=INBOX

# Frontend (linki w PDF potwierdzenia przyjęcia i w e-mailach)
# FRONTEND_BASE_URL=https://twoja-domena.pl

# Dane kontaktowe na wydruku PDF (potwierdzenie przyjęcia A4) — nadpisz w produkcji
# SERWIS_PRINT_COMPANY_NAME=PRO-KOM Serwis
# SERWIS_PRINT_TAGLINE=Serwis elektroniki użytkowej
# SERWIS_PRINT_PHONE=+48 18 266 21 21
# SERWIS_PRINT_EMAIL=serwis@pro-kom.eu
# SERWIS_PRINT_ADDRESS=ul. Przykładowa 1, 00-000 Miasto
# SERWIS_PRINT_HOURS=Pn–Pt 9:00–17:00
# SERWIS_PRINT_WEBSITE=www.pro-kom.eu

# CORS / Allowed hosts (produkcja)
ALLOWED_HOSTS=localhost,127.0.0.1

# SMS (implementacja w późniejszym etapie)
# SMSAPI_TOKEN=twoj_token_smsapi

# Storage S3 (implementacja w późniejszym etapie)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
