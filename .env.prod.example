# =============================================================================
# PRO-KOM Serwis — Production Environment Variables
# Skopiuj ten plik jako .env.prod i uzupełnij wartości.
# NIGDY nie commituj .env.prod do repozytorium!
# =============================================================================

# Django
SECRET_KEY=zmien-na-losowy-klucz-minimum-50-znakow
DEBUG=False
ALLOWED_HOSTS=prokomserwis.pl,www.prokomserwis.pl
DJANGO_SETTINGS_MODULE=config.settings.prod
FRONTEND_BASE_URL=https://prokomserwis.pl

# Baza danych PostgreSQL
DATABASE_URL=postgres://prokom:HASLO_DB@db:5432/prokom_db
POSTGRES_DB=prokom_db
POSTGRES_USER=prokom
POSTGRES_PASSWORD=HASLO_DB

# Redis
REDIS_URL=redis://:HASLO_REDIS@redis:6379/0
REDIS_PASSWORD=HASLO_REDIS

# Next.js (build args)
NEXT_PUBLIC_API_URL=https://prokomserwis.pl
NEXT_PUBLIC_SITE_URL=https://prokomserwis.pl
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google OAuth (backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=serwisprokomrabka@gmail.com
EMAIL_HOST_PASSWORD=HASLO_APLIKACJI_GMAIL
DEFAULT_FROM_EMAIL=serwisprokomrabka@gmail.com

# Powiadomienia wewnetrzne o zgloszeniach z formularzy publicznych (lista po przecinku)
STAFF_NOTIFICATION_EMAILS=serwisprokomrabka@gmail.com

# Dane na wydruku PDF
SERWIS_PRINT_COMPANY_NAME=PRO-KOM Tadeusz Wójciak
SERWIS_PRINT_TAGLINE=Serwis elektroniki użytkowej
SERWIS_PRINT_PHONE=883-200-151
SERWIS_PRINT_EMAIL=serwisprokomrabka@gmail.com
SERWIS_PRINT_ADDRESS=34-700 Rabka-Zdrój, ul. Orkana 16B
SERWIS_PRINT_HOURS=Pn–Pt 9:00–17:00 · Sob 9:00–13:00
SERWIS_PRINT_WEBSITE=www.prokomserwis.pl

# Paczkomat serwisu
PARCEL_LOCKER_ADDRESS=Zakopiańska 10f, Rabka-Zdrój 34-700, przy stacji benzynowej Moya
