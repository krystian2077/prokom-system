# Backend API (Django)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Domena publiczna (bez trailing slash)
NEXT_PUBLIC_SITE_URL=https://prokomserwis.pl

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Opcjonalnie: analityka Umami (puste ID = bez skryptu), service worker (0 = wyrejestruj, kill switch),
# adres raportów CSP, ramki draftów (1 tylko lokalnie i na stagingu, nigdy na produkcji)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_TECH_SW=
NEXT_PUBLIC_CSP_REPORT_URI=
NEXT_PUBLIC_TECH_DRAFT=

# Opcjonalnie: token do developmentu (nie commituj prawdziwego tokenu)
# AUTH_TOKEN=...
