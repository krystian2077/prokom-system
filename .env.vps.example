# =============================================================================
# prokom-tech na VPS — wzór plików .env.prod i .env.staging (docs/tech/WDROZENIE.md)
# Na serwerze: /srv/prokom/prokom-tech/.env.prod i .env.staging, chmod 600, NIGDY w repo.
# Klucze aplikacji jak w .env.prod.example (Hetzner) + blok serwerowy na dole.
# Różnice prod/staging: docs/tech/MIGRACJA-VPS.md §5.
# =============================================================================

# --- Django ---
SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=prokomserwis.pl,www.prokomserwis.pl        # staging: staging.prokomserwis.pl
FRONTEND_BASE_URL=https://prokomserwis.pl                 # staging: https://staging.prokomserwis.pl

# --- Baza (usługa `db` w stosie; użytkownik zawsze `prokom`) ---
# Hasło tylko hex (openssl rand -hex 24), bo idzie wprost do DATABASE_URL. Inne hasło na staging.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://prokom:<POSTGRES_PASSWORD>@db:5432/prokom_tech_prod   # staging: …/prokom_tech_staging

# --- Redis (usługa `redis` w stosie) ---
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# --- Next.js: wartości NEXT_PUBLIC_* idą do obrazu w GitHub Actions (Environment production/staging),
#     tu tylko dla porządku i dla smoke testu ---
NEXT_PUBLIC_API_URL=https://prokomserwis.pl               # staging: https://staging.prokomserwis.pl
NEXT_PUBLIC_SITE_URL=https://prokomserwis.pl              # staging: https://staging.prokomserwis.pl
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Google OAuth (backend) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail (dziś Gmail; TM+ etap D przełącza na SH 1) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# staging: tylko adres Krystiana
STAFF_NOTIFICATION_EMAILS=

# --- Dane serwisu (blok „Twój serwis” w /track, wydruki) ---
SERWIS_PRINT_COMPANY_NAME=
SERWIS_PRINT_TAGLINE=
SERWIS_PRINT_PHONE=
SERWIS_PRINT_EMAIL=
SERWIS_PRINT_ADDRESS=
SERWIS_PRINT_HOURS=Pn–Pt 9:00–17:00 · Sob 9:00–14:00
SERWIS_PRINT_WEBSITE=
PARCEL_LOCKER_ADDRESS=

# =============================================================================
# Blok serwerowy (czyta go compose i skrypty scripts/vps/, nie aplikacja)
# =============================================================================
# Pełny SHA commita — ustawia go scripts/vps/deploy.sh, ręcznie tylko przy pierwszym starcie.
APP_IMAGE_TAG=
# Port gatewaya na 127.0.0.1 (smoke test): prod 3300, staging 3301.
GATEWAY_PORT=3300
